# Copy to .env and fill in locally. Never commit .env.
# MCAT Speedrun — optional local overrides (no secrets required for core dev).

# Example:
# ANKI_MCAT_ROOT=C:/Users/you/Downloads/alphaProjects/anki-MCAT

# --- Optional live AI (post-miss explainer + follow-up Q&A) ---
# Unset MCAT_LLM_PROVIDER → AI OFF at runtime (static explanation only).
# MCAT_LLM_PROVIDER=openai
# MCAT_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# Or: MCAT_LLM_API_KEY=...  (generic; takes precedence over provider-specific key)
# Anthropic alternative:
# MCAT_LLM_PROVIDER=anthropic
# MCAT_LLM_MODEL=claude-3-5-sonnet-latest
# ANTHROPIC_API_KEY=...

# --- Hosted AI proxy (KEYLESS clients — the graded/grader build) ---
# When NO direct provider (above) is set, the app can reach live AI through a
# hosted proxy that holds the upstream key server-side, so graders need NO key.
# Set these ONLY to point the app at your deployed proxy (no secret here — the
# real LLM key lives ONLY on the proxy host). Unset/placeholder => proxy OFF =>
# source-based fallback. In the shipped tester bundle these come from a JSON
# file (mcat-ai-proxy.json) instead; see docs/AI-PROXY-SETUP.md.
# MCAT_AI_PROXY_URL=https://mcat-ai-proxy.<you>.workers.dev/
# MCAT_AI_PROXY_TOKEN=your-shared-bundle-token
# MCAT_AI_PROXY_MODEL=gpt-4o-mini
