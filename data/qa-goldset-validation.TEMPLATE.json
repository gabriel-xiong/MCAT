{
  "_instructions": {
    "what_this_is": "Lightweight human-validation sheet for data/qa-goldset.json. You VALIDATE (approve / edit / reject) each pre-authored fact_atom rather than authoring from scratch. This is deliberately cheap: open the matching gold item, read the source question, and mark each atom.",
    "how_to_use": [
      "1. Open data/qa-goldset.json and this file side by side (item ids match, e.g. g001).",
      "2. For each gold item, open the referenced question in data/questions.json by its question_id and read the stem, choices, correct answer, explanation, and choice_feedback.",
      "3. For each fact_atom, set atom_status to 'approve' (fact is correct AND derivable from the curated source), 'edit' (put a corrected wording in atom_fix), or 'reject' (atom is wrong or not supported -> remove it from the key).",
      "4. Optionally review must_not_say entries the same way under must_not_say_review.",
      "5. Set item_decision to 'approved' once every atom is approve/edit; then flip `validated` to true for that item in qa-goldset.json.",
      "6. flagged_for_attention lists atoms the author was unsure about - check these first."
    ],
    "atom_status_values": ["approve", "edit", "reject", "unreviewed"],
    "item_decision_values": ["approved", "needs_changes", "rejected", "unreviewed"],
    "note": "Atom order in this template mirrors the fact_atoms array order in qa-goldset.json (0-indexed via atom_index)."
  },
